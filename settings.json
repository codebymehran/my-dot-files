{
  // ===========================================================
  // 🎨 EDITOR BASICS
  // ===========================================================
  "editor.fontFamily": "'Monolisa', 'JetBrains Mono', 'FiraCode', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.lineHeight": 1.6,
  "editor.tabSize": 2,

  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.renderWhitespace": "selection",
  "editor.stickyScroll.enabled": true,
  "explorer.autoReveal": "focusNoScroll",
  "search.quickOpen.includeSymbols": true,
  "search.quickOpen.includeHistory": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSurroundingLines": 8,
  "editor.letterSpacing": 0.5,
  "editor.padding.top": 16,
  "editor.padding.bottom": 16,

  // ===========================================================
  // 🎯 CODE INTELLIGENCE
  // ===========================================================
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,

  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "on",

  "editor.tabCompletion": "on",
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  "editor.snippetSuggestions": "top",

  "editor.suggest.preview": false,
  "editor.suggest.showInlineDetails": false,

  "editor.showUnused": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.stickyScroll.scrollWithEditor": true,
  "editor.lineNumbers": "relative",
  "editor.renderLineHighlight": "all",
  // Snippet suggestions appear in dropdown while typing inside placeholders
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // Jumps directly when multiple definitions exist (useful with TS interfaces)
  // References stay inline as peek so they don't open a new tab
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleReferences": "peek",

  // ===========================================================
  // 🚀 JAVASCRIPT / TYPESCRIPT
  // ===========================================================
  // non-relative uses @/ aliases instead of ../../ — correct for Next.js tsconfig paths
  "js/ts.preferences.importModuleSpecifier": "non-relative",
  "js/ts.preferences.includePackageJsonAutoImports": "auto",
  "js/ts.preferences.quoteStyle": "single",

  "js/ts.updateImportsOnFileMove.enabled": "always",

  // Inlay hints — literals only keeps it readable without cluttering every line
  // e.g. setTimeout(fn, /* ms */ 1000) instead of annotating every variable
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.variableTypes.enabled": false,

  // Shows "2 references" above functions — see what's using them without Find References
  "js/ts.referencesCodeLens.enabled": true,
  "js/ts.implementationsCodeLens.enabled": true,

  // ===========================================================
  // 🐍 PYTHON CONFIGURATION
  // ===========================================================
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "editor.rulers": [88]
  },

  // Pylance off — not actively coding in Python, switch to "Pylance" when needed
  "python.languageServer": "None",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoSearchPaths": true,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.variableTypes": true,

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,

  "isort.args": ["--profile", "black"],

  "autoDocstring.docstringFormat": "google",
  "autoDocstring.startOnNewLine": false,

  // ===========================================================
  // 💾 AUTO-SAVE & FORMATTING
  // ===========================================================
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Per-language formatter overrides — prevents TS language server
  // from fighting with Prettier on .ts and .tsx files
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },

  // ===========================================================
  // 📁 FILE ASSOCIATIONS
  // ===========================================================
  "files.associations": {
    "*.jsx": "javascriptreact",
    "*.css": "tailwindcss",
    "*.py": "python",
    "requirements.txt": "pip-requirements",
    "Pipfile": "toml",
    ".env": "dotenv"
  },

  "files.exclude": {
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.git": true,
    "**/dist": true,
    "**/build": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/.venv": false,
    "**/venv": false
  },

  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },

  // ===========================================================
  // ⚛️ REACT + TAILWIND + EMMET
  // ===========================================================
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact",
    "python": "python"
  },
  "emmet.triggerExpansionOnTab": true,

  "css.lint.unknownAtRules": "ignore",

  // ===========================================================
  // 🔍 SEARCH
  // ===========================================================
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/venv": true
  },

  "search.smartCase": true,
  "search.followSymlinks": false,

  // ===========================================================
  // 🖥️ TERMINAL
  // ===========================================================
  "terminal.integrated.fontFamily": "JetBrains Mono Nerd Font",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
 

  // ===========================================================
  // 🎯 WORKBENCH - MINIMAL UI
  // ===========================================================
  "workbench.activityBar.location": "top",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": true,
  "workbench.iconTheme": "vscode-icons",

  "workbench.tree.indent": 15,
  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  "window.commandCenter": false,

  "workbench.editor.showTabs": "multiple",

  // ===========================================================
  // 🔀 GIT
  // ===========================================================
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.experimental.showMoves": true,
  "merge-conflict.autoNavigateNextConflict.enabled": true,

  // ===========================================================
  // ⚠️ ERROR LENS
  // ===========================================================
  "errorLens.enabled": true,
  "errorLens.fontSize": "0.9em",
  "errorLens.fontWeight": "400",
  "errorLens.messageEnabled": true,

  // ===========================================================
  // 🔍 ESLINT
  // ===========================================================
  // format.enable false keeps Prettier as the only formatter
  // prevents ESLint and Prettier fighting over the same file
  "eslint.format.enable": false,
  "eslint.lintTask.enable": true,

  // ===========================================================
  // 💬 COLORFUL COMMENTS - OPTIMIZED FOR WHITE THEME
  // ===========================================================
  "colorful-comments.tags": [
    {
      "tag": "===",
      "color": "#0066CC",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "---",
      "color": "#00A3CC",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "...",
      "color": "#4A90E2",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "*",
      "color": "#1FA73F",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "!",
      "color": "#FF2D00",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": true,
      "italic": false
    },
    {
      "tag": "?",
      "color": "#7D3C98",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": true
    },
    {
      "tag": "@",
      "color": "#D68910",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "^",
      "color": "#474747",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": true
    },
    {
      "tag": "todo",
      "color": "#FF8C00",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "+",
      "color": "#00B050",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "-",
      "color": "#C70039",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "//",
      "color": "#999999",
      "strikethrough": true,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "$",
      "color": "#E67E22",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "%",
      "color": "#D4009E",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "&",
      "color": "#8A4FFF",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "~",
      "color": "#00CED1",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": "=",
      "color": "#B8860B",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    },
    {
      "tag": ">",
      "color": "#556B2F",
      "strikethrough": false,
      "backgroundColor": "transparent",
      "bold": false,
      "italic": false
    }
  ],

  // ===========================================================
  // 🚀 VIM CONFIGURATION – CLEAN & ERGONOMIC
  // 📚 See vim-reference.md for full shortcuts & workflows guide
  // ===========================================================
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 300,
  "vim.camelCaseMotion.enable": true,
  "vim.smartcase": true,
  "vim.ignorecase": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.visualstar": true,
  "vim.smartRelativeLine": true,

  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.easymotion": false,
  "vim.surround": true,
  "vim.replaceWithRegister": true,
  "vim.startInInsertMode": false,
  "vim.timeout": 200,

  "vim.argumentObjectSeparators": [",", ";"],
  "vim.argumentObjectOpeningDelimiters": ["(", "["],
  "vim.argumentObjectClosingDelimiters": [")", "]"],

  // ===========================================================
  // ⚡ INSERT MODE – ESCAPE
  // ===========================================================
  "vim.insertModeKeyBindings": [{ "before": ["j", "j"], "after": ["<Esc>"] }],

  // ===========================================================
  // 🔧 CTRL KEY HANDLING – ONLY WHAT VIM NEEDS
  // Ctrl+h/j/k/l handled in keybindings.json for split navigation.
  // Only giving Vim the core ops it needs here.
  // ===========================================================
  "vim.handleKeys": {
    "<C-a>": true,
    "<C-x>": true,
    "<C-v>": true
  },

  // ===========================================================
  // 🎯 NORMAL MODE – ESSENTIAL ERGONOMIC REMAPS
  // ===========================================================
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "<Tab>"],
      "commands": ["alternator.switch", "extension.vim_escape"]
    },
{ "before": ["<Esc>"], "after": ["<Esc>"], "commands": [":noh"] },
    { "before": ["p"], "after": ["\"", "0", "p"] },

    {
      "before": ["{"],
      "after": ["{", "z", "z"]
    },
    {
      "before": ["}"],
      "after": ["}", "z", "z"]
    },

    // Redo (ergonomic)
    { "before": ["U"], "after": ["<C-r>"] },
    { "before": ["B"], "after": ["<C-v>"] },

    // =======================================================
    // 💾 SAVE / CLOSE (Mac-native muscle memory)
    // =======================================================
    { "before": ["<D-s>"], "commands": ["workbench.action.files.save"] },
    { "before": ["<D-w>"], "commands": ["workbench.action.closeActiveEditor"] },

    // =======================================================
    // 🔍 IDE / WORKSPACE NAVIGATION
    // =======================================================
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "t"], "commands": ["workbench.action.terminal.toggleTerminal"] },
    { "before": ["<leader>", "p"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<leader>", "f"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["<leader>", "b"], "commands": ["workbench.action.toggleSidebarVisibility"] },
    { "before": ["<leader>", "r"], "commands": ["workbench.action.openRecent"] },
    { "before": ["<leader>", "z"], "commands": ["workbench.action.toggleZenMode"] },

    // =======================================================
    // 🛠️ CODE ACTIONS
    // =======================================================
    { "before": ["<leader>", "a"], "commands": ["editor.action.quickFix"] },
    { "before": ["<leader>", "n"], "commands": ["editor.action.rename"] },
    { "before": ["<leader>", "s"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["<leader>", "m"], "commands": ["references-view.findReferences"] },

    // =======================================================
    // 📄 FILE OPERATIONS
    // =======================================================
    { "before": ["<leader>", "w"], "commands": ["workbench.action.files.save"] },
    { "before": ["<leader>", "q"], "commands": ["workbench.action.closeActiveEditor"] },
    { "before": ["<leader>", "o"], "commands": ["workbench.action.closeOtherEditors"] },
    { "before": ["<leader>", "q", "a"], "commands": ["workbench.action.closeUnmodifiedEditors"] },

    // =======================================================
    // 📄 SPLIT CREATION
    // =======================================================
    { "before": ["<leader>", "v"], "commands": ["workbench.action.splitEditorRight"] },
    { "before": ["<leader>", "\\"], "commands": ["workbench.action.splitEditorDown"] },
    { "before": ["<leader>", "t", "v"], "commands": ["workbench.action.terminal.split"] },
    { "before": ["<leader>", "t", "s"], "commands": ["workbench.action.terminal.splitActiveTab"] },
    { "before": ["<leader>", "t", "n"], "commands": ["workbench.action.terminal.new"] },
    { "before": ["<leader>", "t", "k"], "commands": ["workbench.action.terminal.kill"] },

    // =======================================================
    // 🔍 SEARCH / CENTERING
    // =======================================================
    { "before": ["n"], "after": ["n", "z", "z"] },
    { "before": ["N"], "after": ["N", "z", "z"] },
    { "before": ["*"], "after": ["*", "z", "z"] },
    { "before": ["#"], "after": ["#", "z", "z"] },

    // =======================================================
    // ↔️ KEEP SELECTION AFTER INDENT
    // =======================================================
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<"], "after": ["<", "g", "v"] },

    // =======================================================
    // 🧭 GO TO DEFINITION / REFERENCES
    // =======================================================
    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "D"], "commands": ["editor.action.peekDefinition"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    // gi is intentionally not remapped — falls back to native Vim (jump to last insert point)
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "h"], "commands": ["editor.action.showHover"] },

    { "before": ["g", ";"], "commands": ["workbench.action.navigateBack"] },
    { "before": ["g", ","], "commands": ["workbench.action.navigateForward"] },

    // =======================================================
    // 🧭 ERROR NAVIGATION
    // =======================================================
    { "before": ["]", "d"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },

    // =======================================================
    // 🧭 BUFFER NAVIGATION
    // =======================================================
    { "before": ["<Tab>"], "commands": ["workbench.action.nextEditor"] },
    { "before": ["<S-Tab>"], "commands": ["workbench.action.previousEditor"] },

    // =======================================================
    // 🧩 MOVE LINES
    // =======================================================
    { "before": ["<leader>", "j"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["<leader>", "k"], "commands": ["editor.action.moveLinesUpAction"] },

    // =======================================================
    // 🧹 FORMAT & IMPORTS
    // =======================================================
    { "before": ["<leader>", ";"], "commands": ["editor.action.formatDocument"] },
    { "before": ["<leader>", "i"], "commands": ["editor.action.organizeImports"] },

    // =======================================================
    // 📋 FILE COPY / REPLACE
    // =======================================================
    { "before": ["<leader>", "c"], "commands": ["editor.action.selectAll", "editor.action.clipboardCopyAction"] },
    { "before": ["<leader>", "x"], "commands": ["editor.action.selectAll", "editor.action.clipboardPasteAction"] },

    // =======================================================
    // 🔁 DUPLICATE LINE
    // =======================================================
    { "before": ["<leader>", "d"], "commands": ["editor.action.copyLinesDownAction"] },

    // =======================================================
    // 🗂️ FOLDS
    // =======================================================
    { "before": ["z", "o"], "commands": ["editor.unfold"] },
    { "before": ["z", "c"], "commands": ["editor.fold"] },
    { "before": ["z", "O"], "commands": ["editor.unfoldAll"] },
    { "before": ["z", "C"], "commands": ["editor.foldAll"] },

    // =======================================================
    // 🆕 Quick Git Actions
    // =======================================================
    { "before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "g", "c"], "commands": ["git.commit"] },
    { "before": ["<leader>", "g", "p"], "commands": ["git.push"] },
    { "before": ["<leader>", "g", "P"], "commands": ["git.pull"] },

    // =======================================================
    // 🧩 QUALITY OF LIFE MOVEMENT
    // =======================================================
    { "before": ["J"], "after": ["5", "j"] },
    { "before": ["K"], "after": ["5", "k"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["L"], "after": ["$"] }
  ],

  // ===========================================================
  // 👁️ VISUAL MODE
  // ===========================================================
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["J"], "after": ["5", "j"] },
    { "before": ["K"], "after": ["5", "k"] },
    { "before": ["H"], "after": ["^"] },
    { "before": ["L"], "after": ["$"] },

    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<"], "after": ["<", "g", "v"] },

    { "before": ["g", "c"], "commands": ["editor.action.commentLine"] },
    { "before": ["g", "c", "c"], "commands": ["editor.action.commentLine", "extension.vim_escape"] },

    { "before": ["p"], "after": ["p", "g", "v", "y"] }
  ],

  // ===========================================================
  // 🔧 MISC
  // ===========================================================
  "telemetry.telemetryLevel": "off",
  "security.workspace.trust.untrustedFiles": "open",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.accessibilitySupport": "off",

  // ===========================================================
  // 🌟 PRETTIER
  // ===========================================================
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "prettier.printWidth": 100,
  "prettier.semi": true,
  "prettier.tabWidth": 2,
  "prettier.arrowParens": "avoid",
  "workbench.editor.tabActionLocation": "right",
  "workbench.settings.editor": "ui",
  "eslint.run": "onSave",
  "workbench.editor.pinnedTabSizing": "compact",
  "workbench.colorTheme": "Hop Light (Italics)",

  // ===========================================================
  // ⚙️ PERFORMANCE
  // ===========================================================
  // Runs Vim extension on its own thread — prevents keystroke lag
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  }
}
