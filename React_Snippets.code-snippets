      "",
      "export function use${1:Resource}() {",
      "  const [data, setData] = useState<${2:YourType}[] | null>(null)",
      "  const [isLoading, setIsLoading] = useState(true)",
      "  const [error, setError] = useState<string | null>(null)",
      "",
      "  useEffect(() => {",
      "    async function fetchData() {",
      "      try {",
      "        setIsLoading(true)",
      "        const result = await ${3:yourApiCall()}",
      "        setData(result)",
      "        setError(null)",
      "      } catch (err) {",
      "        setError((err as Error).message)",
      "        setData(null)",
      "      } finally {",
      "        setIsLoading(false)",
      "      }",
      "    }",
      "    fetchData()",
      "  }, [])",
      "",
      "  return { data, isLoading, error }",
      "}"
    ],
    "description": "Reusable fetch hook. Use when the same fetch logic appears in more than one component. Returns { data, isLoading, error }.",
    "scope": "typescript,typescriptreact"
  },

