  "Full Client Component": {
    "prefix": "rcomp",
    "body": [
      "/* 'use client' --------------------------------------------------------------",
      "   Required because this component uses useState and useEffect.",
      "   Remove only if you move all state and fetch logic to a Server Component.  */",
      "'use client'",
      "",
      "/* -- Imports --------------------------------------------------------------",
      "   Add any other imports you need: router, Link, Image, cn, actions, etc.  */",
      "import { useState, useEffect } from 'react'",
      "",
      "/* -- Types ----------------------------------------------------------------",
      "   Props this component receives from its parent.",
      "   Delete the interface if this component has no props yet.                */",
      "interface ${1:ComponentName}Props {",
      "  // Add props here as you need them. Examples:",
      "  // userId: string",
      "  // onSuccess?: () => void  -- the ? makes it optional",
      "}",
      "",
      "/* -- Component ------------------------------------------------------------",
      "   Fill these in before writing any code -- keeps the component focused.",
      "   What this component does:              ${2:...}",
      "   What it does NOT do:                   ${3:...}",
      "   What the parent is responsible for:    ${4:...}          */",
      "",
      "const ${1:ComponentName} = ({}: ${1:ComponentName}Props) => {",
      "",
      "  /* -- State --------------------------------------------------------------",
      "     data      -- what was fetched. Starts null, filled after fetch succeeds.",
      "     isLoading -- true while request is in-flight. Drives the loading UI.",
      "     error     -- holds the error message string if the fetch fails.       */",
      "  const [data, setData] = useState<${5:YourType}[] | null>(null)",
      "  const [isLoading, setIsLoading] = useState(true)",
      "  const [error, setError] = useState<string | null>(null)",
      "",
      "  /* -- Fetch Data ---------------------------------------------------------",
      "     loadData is defined as an inner async function then called immediately.",
      "     This is the correct pattern -- useEffect itself cannot be async.",
      "     Empty [] dep array means this runs once on mount only.               */",
      "  useEffect(() => {",
      "    async function loadData() {",
      "      try {",
      "        setIsLoading(true)",
      "        const result = await ${6:yourApiCall()}",
      "        setData(result)",
      "        setError(null)",
      "      } catch (err) {",
      "        setError((err as Error).message)",
      "        setData(null)",
      "      } finally {",
      "        setIsLoading(false)",
      "      }",
      "    }",
      "    loadData()",
      "  }, [])",
      "",
      "  /* -- Handlers -----------------------------------------------------------",
      "     After a mutation (create / update / delete):                          ",
      "     - Server Actions  --> call router.refresh() to re-sync Server Components",
      "     - Client fetch    --> re-call loadData() to re-fetch                 */",
      "  const handle${7:Action} = async () => {",
      "    try {",
      "      await ${8:yourMutationCall()}",
      "      // TODO: re-fetch or optimistically update state here",
      "    } catch (err) {",
      "      setError((err as Error).message)",
      "    }",
      "  }",
      "",
      "  /* -- Early Returns ------------------------------------------------------",
      "     Must come BEFORE the main return -- they short-circuit rendering.",
      "     Order matters: loading --> error --> empty --> render.               */",
      "  if (isLoading) return <p className=\"text-sm text-muted-foreground\">Loading...</p>",
      "  if (error) return <p className=\"text-sm text-red-500\">Error: {error}</p>",
      "  if (!data?.length) return <p className=\"text-sm text-muted-foreground\">Nothing here yet.</p>",
      "",
      "  /* -- Render -------------------------------------------------------------*/",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  )",
      "}",
      "",
      "export default ${1:ComponentName}"
    ],
    "scope": "typescript,typescriptreact"
  },

